---
import Base from '../layouts/Base.astro';
import HoloCard from '../components/HoloCard.astro';
import { resources } from '../data/resources';
// 每个软件的 logo、品牌色（同时用作箔片色与光晕色）和箔纹
const look: Record<string, { logo: string; preset: any; accent: string; foil: string; scale?: number; intensity?: number; tint?: number }> = {
  'Codex': { logo: 'openai.svg', preset: 'shards', accent: '#9a7a2a', foil: '#f6d27a', scale: 0.44, intensity: 0.55, tint: 0.95 }, // 黑金：黑底 + 金色碎片箔纹（与 FlClash 同纹路）
  'Claude': { logo: 'claude.svg', preset: 'shards', accent: '#d97757', foil: '#e8a07f', scale: 0.46 },
  'FlClash': { logo: 'flclash.png', preset: 'shards', accent: '#5b7cf5', foil: '#6e8cff', scale: 0.5 },
  'door4ai.com': { logo: 'door4ai.svg', preset: 'gold', accent: '#1f5fd1', foil: '#9fc0ff', scale: 0.44 },
};
const CARD_W = 170;
// 平台 → 卡面主图标（Font Awesome Free 品牌图标，CC BY 4.0）
const platformLogo = (label: string) => /mac/i.test(label) ? 'apple.svg' : /windows/i.test(label) ? 'windows.svg' : /linux/i.test(label) ? 'linux.svg' : /android/i.test(label) ? 'android.svg' : undefined;
---
<Base title="Resource · Door4AI Lab" description="常用工具的下载入口，由本站镜像最新安装包。" full>
  {resources.map((r) => { const k = look[r.title] || { logo: '', preset: 'bursts', accent: '#6f9cf0', foil: '#e2e6ec' }; return (
    <section class="resgroup" style={`--brand:${k.accent}`}>
      <div class="reshead">
        <h2 class="rt">{r.title}</h2>
      </div>
      <div class="cardrow" aria-label={`${r.title} 下载`}>
        {r.links.map((l) => (
          <figure class="cardwrap">
            <HoloCard title={l.label} kicker={r.title} foot={l.dl ? '点击下载' : (l.hint || '打开')} logo={k.logo || undefined} platformLogo={platformLogo(l.label)} logoScale={platformLogo(l.label) ? 0.4 : k.scale} preset={k.preset} accent={k.accent} foil={k.foil} intensity={k.intensity} tint={k.tint} width={CARD_W}
              href={l.dl ? `/dl/${l.dl}` : l.url} external={!l.dl} dl={l.dl} />
          </figure>
        ))}
      </div>
    </section>
  ); })}
  <script>
    // #debug：在页面顶部打印第一张卡与画布的尺寸（排查 WebKit 画布问题）
    if (location.hash === '#debug') {
      setTimeout(() => {
        const c = document.querySelector('.holo-card'); const cv = c.querySelector('canvas'); const img = c.querySelector('img');
        const R = (el) => { const r = el.getBoundingClientRect(); return [Math.round(r.width), Math.round(r.height)]; };
        const gl = cv.getContext('webgl2');
        const d = document.createElement('pre'); d.style.cssText = 'position:fixed;top:0;left:0;z-index:9999;background:#000;color:#0f0;font:11px monospace;padding:6px;white-space:pre-wrap;max-width:100vw';
        d.textContent = JSON.stringify({ ua: navigator.userAgent.replace(/Mozilla\/5.0 \(/, '').slice(0, 60), dpr: devicePixelRatio, card: R(c), face: R(cv.parentElement), img: R(img), canvas: R(cv), canvasAttr: [cv.width, cv.height], drawingBuffer: gl ? [gl.drawingBufferWidth, gl.drawingBufferHeight] : null, viewport: gl ? Array.from(gl.getParameter(gl.VIEWPORT)) : null, canvasStyle: cv.getAttribute('style'), computed: getComputedStyle(cv).width + ' ' + getComputedStyle(cv).height, ready: c.dataset.ready !== undefined, inner: [innerWidth, innerHeight] }, null, 1);
        document.body.appendChild(d);
      }, 2500);
    }
    // 读镜像清单：缺失的卡片置灰；版本 / 大小 / 校验值放到悬停提示里
    (async () => {
      const fmt = (n) => (n >= 1e9 ? (n / 1e9).toFixed(2) + ' GB' : n >= 1e6 ? (n / 1e6).toFixed(1) + ' MB' : Math.round(n / 1e3) + ' KB');
      try {
        const r = await fetch('/dl/manifest.json', { credentials: 'include' });
        if (!r.ok) return;
        const m = await r.json();
        document.querySelectorAll('.holo-card[data-dl]').forEach((card) => {
          const it = m.items[card.dataset.dl];
          if (!it || it.missing) { card.classList.add('off'); card.title = '镜像尚未同步'; return; }
          const ver = /^v?\d+(\.\d+)+$/.test(it.version) ? it.version : '最新';
          card.title = `${ver} · ${fmt(it.size)}` + (it.sha256 ? `\nSHA256 ${it.sha256}` : '');
        });
      } catch (e) {}
    })();
  </script>
</Base>
