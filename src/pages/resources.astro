---
import Base from '../layouts/Base.astro';
import HoloCard from '../components/HoloCard.astro';
import { resources } from '../data/resources';
// 每个软件的 logo、品牌色（同时用作箔片色与光晕色）和箔纹
const look: Record<string, { logo: string; preset: any; accent: string; foil: string; scale?: number }> = {
  'Codex': { logo: 'openai.svg', preset: 'cosmos', accent: '#9fb3c8', foil: '#e6ebf0', scale: 0.44 },
  'Claude': { logo: 'claude.svg', preset: 'glitter', accent: '#d97757', foil: '#e8a07f', scale: 0.46 },
  'FlClash': { logo: 'flclash.png', preset: 'shards', accent: '#5b7cf5', foil: '#6e8cff', scale: 0.5 },
  'door4ai.com': { logo: 'door4ai.svg', preset: 'gold', accent: '#1f5fd1', foil: '#9fc0ff', scale: 0.44 },
};
const CARD_W = 170;
// 平台 → 卡面主图标（Font Awesome Free 品牌图标，CC BY 4.0）
const platformLogo = (label: string) => /mac/i.test(label) ? 'apple.svg' : /windows/i.test(label) ? 'windows.svg' : /linux/i.test(label) ? 'linux.svg' : /android/i.test(label) ? 'android.svg' : undefined;
---
<Base title="Resource · Door4AI Lab" description="常用工具的下载入口，由本站镜像最新安装包。" full>
  {resources.map((r) => { const k = look[r.title] || { logo: '', preset: 'bursts', accent: '#6f9cf0', foil: '#e2e6ec' }; return (
    <section class="resgroup" style={`--brand:${k.accent}`}>
      <div class="reshead">
        <h2 class="rt">{r.title}</h2>
      </div>
      <div class="cardrow" aria-label={`${r.title} 下载`}>
        {r.links.map((l) => (
          <figure class="cardwrap">
            <HoloCard title={l.label} kicker={r.title} foot={l.dl ? '点击下载' : (l.hint || '打开')} logo={k.logo || undefined} platformLogo={platformLogo(l.label)} logoScale={platformLogo(l.label) ? 0.4 : k.scale} preset={k.preset} accent={k.accent} foil={k.foil} width={CARD_W}
              href={l.dl ? `/dl/${l.dl}` : l.url} external={!l.dl} dl={l.dl} />
          </figure>
        ))}
      </div>
    </section>
  ); })}
  <script>
    // 读镜像清单：缺失的卡片置灰；版本 / 大小 / 校验值放到悬停提示里
    (async () => {
      const fmt = (n) => (n >= 1e9 ? (n / 1e9).toFixed(2) + ' GB' : n >= 1e6 ? (n / 1e6).toFixed(1) + ' MB' : Math.round(n / 1e3) + ' KB');
      try {
        const r = await fetch('/dl/manifest.json', { credentials: 'include' });
        if (!r.ok) return;
        const m = await r.json();
        document.querySelectorAll('.holo-card[data-dl]').forEach((card) => {
          const it = m.items[card.dataset.dl];
          if (!it || it.missing) { card.classList.add('off'); card.title = '镜像尚未同步'; return; }
          const ver = /^v?\d+(\.\d+)+$/.test(it.version) ? it.version : '最新';
          card.title = `${ver} · ${fmt(it.size)}` + (it.sha256 ? `\nSHA256 ${it.sha256}` : '');
        });
      } catch (e) {}
    })();
  </script>
</Base>
