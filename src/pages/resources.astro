---
import Base from '../layouts/Base.astro';
import { resources } from '../data/resources';
---
<Base title="Resource · Door4AI Lab" description="常用工具的下载入口，按平台分列。">
  <div class="eyebrow">Resource</div>
  <h1>Resource</h1>
  <ul class="reslist">
    {resources.map((r) => (
      <li>
        <span class="rt">{r.title}</span>
        <span class="d">{r.note}</span>
        <div class="plat">
          {r.links.map((l) => (
            <a href={l.url} target="_blank" rel="noopener" title={l.hint}>{l.label} ↗{l.hint && <small>{l.hint}</small>}</a>
          ))}
        </div>
      </li>
    ))}
  </ul>
</Base>
