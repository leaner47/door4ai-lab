---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { PARTS, partOf } from '../data/course';
const posts = (await getCollection('blog'))
  .filter((p) => p.data.series === 'ai-mastery')
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const numbered = posts.map((p, i) => ({ p, n: i + 1 }));
const groups = PARTS.map((part) => ({ part, items: numbered.filter(({ p }) => partOf(p.data.order).key === part.key) })).filter((g) => g.items.length);
---
<Base title="AI 从入门到精通 · Door4AI Lab" description="系统课程：从模型怎么算到推理怎么省，每一讲配可交互实验。">
  <div class="eyebrow">Course</div>
  <h1>AI 从入门到精通</h1>
  <p class="prose" style="color:var(--muted)">按顺序读。大多数讲配有一个可以动手的实验，先玩实验再看文字，理解会快很多。</p>
  <section class="act" id="act" aria-label="学习记录">
    <div class="act-top">
      <span class="act-title">学习记录</span>
      <span class="act-sum" id="act-sum">还没有学习记录</span>
    </div>
    <div class="act-scroll" id="act-scroll">
      <div class="act-grid" id="act-grid" role="img" aria-label="过去一年每天的学习次数"></div>
    </div>
    <div class="act-foot">
      <span>记录只保存在这台设备的浏览器里</span>
      <span class="act-legend">少<i data-l="0"></i><i data-l="1"></i><i data-l="2"></i><i data-l="3"></i><i data-l="4"></i>多</span>
    </div>
  </section>
  {groups.map(({ part, items }, gi) => (
    <section class="part">
      <header class="part-head">
        <div class="part-kicker">第 {['一', '二', '三', '四', '五', '六'][gi] ?? gi + 1} 篇 · {items.length} 讲</div>
        <h2 class="part-title">{part.title}<span>{part.sub}</span></h2>
        <p class="part-desc">{part.desc}</p>
      </header>
      <ul class="postlist">
        {items.map(({ p, n }) => (
          <li data-slug={p.id}>
            <div class="num" aria-hidden="true">{String(n).padStart(2, '0')}</div>
            <div>
              <a class="t" href={`/posts/${p.id}/`}>{p.data.title}</a>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <script>
    // 学习记录只存在本机浏览器（localStorage 的 d4a-activity = {日期: 次数}，文章页每打开一次 +1，重复读也算）
    // → GitHub 贡献图式的学习面板（53 周 × 7 天，周一在上）
    (() => {
      let log: Record<string, number | string[]> = {};
      try { log = JSON.parse(localStorage.getItem('d4a-activity') || '{}'); } catch (e) {}
      const count = (v: unknown) => (Array.isArray(v) ? v.length : +(v as number) || 0);
      const level = (n: number) => (n === 0 ? 0 : n === 1 ? 1 : n <= 3 ? 2 : n <= 6 ? 3 : 4);

      const key = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      const today = new Date(); today.setHours(0, 0, 0, 0);
      const dow = (today.getDay() + 6) % 7; // 周一 = 0
      const WEEKS = 53;
      const start = new Date(today); start.setDate(today.getDate() - dow - (WEEKS - 1) * 7);
      const grid = document.getElementById('act-grid')!;
      const frag = document.createDocumentFragment();
      // 第一列：星期标签（一、三、五）
      const wk = document.createElement('div'); wk.className = 'act-col act-wd';
      wk.innerHTML = '<b></b>' + ['一', '', '三', '', '五', '', ''].map((t) => `<span>${t}</span>`).join('');
      frag.append(wk);
      let days = 0, total = 0, lastMonth = -1;
      for (let w = 0; w < WEEKS; w++) {
        const col = document.createElement('div'); col.className = 'act-col';
        const first = new Date(start); first.setDate(start.getDate() + w * 7);
        const m = document.createElement('b');
        if (first.getMonth() !== lastMonth && w < WEEKS - 1) { m.textContent = `${first.getMonth() + 1}月`; lastMonth = first.getMonth(); }
        col.append(m);
        for (let d = 0; d < 7; d++) {
          const day = new Date(first); day.setDate(first.getDate() + d);
          const c = document.createElement('i');
          if (day > today) { c.className = 'future'; col.append(c); continue; }
          const n = count(log[key(day)]);
          if (n) { days++; total += n; }
          c.dataset.l = String(level(n));
          c.title = `${day.getMonth() + 1}月${day.getDate()}日：${n ? `学习 ${n} 次` : '没有学习记录'}`;
          if (+day === +today) c.classList.add('today');
          col.append(c);
        }
        frag.append(col);
      }
      grid.append(frag);
      // 连续天数：从今天往前数（今天还没学就从昨天开始数）
      let streak = 0; const cur = new Date(today);
      if (!count(log[key(cur)])) cur.setDate(cur.getDate() - 1);
      while (count(log[key(cur)])) { streak++; cur.setDate(cur.getDate() - 1); }
      document.getElementById('act-sum')!.textContent = total
        ? `过去一年学习 ${total} 次 · ${days} 天${streak > 1 ? ` · 连续 ${streak} 天` : ''}`
        : '还没有学习记录';
      const sc = document.getElementById('act-scroll')!; sc.scrollLeft = sc.scrollWidth; // 手机上默认显示最近几周
    })();
  </script>
</Base>
