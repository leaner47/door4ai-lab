---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import WhatsAppJoin from '../../components/WhatsAppJoin.astro';
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: post }));
}
const post = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base title={`${post.data.title} · Door4AI Lab`} description={post.data.description} full={!!post.data.lab}>
  {post.data.lab ? (
    <article class="with-lab">
      <h1 class="sr-only">{post.data.title}</h1>
      <iframe class="lab-embed" src={post.data.lab} title={post.data.title} scrolling="no" data-autosize></iframe>
      <div class="post-body">
        <div class="prose"><Content /></div>
        {post.data.series && <WhatsAppJoin variant="inline" />}
      </div>
    </article>
  ) : (
    <article>
      <div class="eyebrow">{fmt(post.data.pubDate)}{post.data.updatedDate && ` · 更新 ${fmt(post.data.updatedDate)}`}</div>
      <h1>{post.data.title}</h1>
      <p class="prose" style="color:var(--muted);margin-top:0">{post.data.description}</p>
      {post.data.tags.length > 0 && <div class="tags">{post.data.tags.map((t) => <span class="tag">{t}</span>)}</div>}
      <div class="prose"><Content /></div>
      {post.data.series && <WhatsAppJoin variant="inline" />}
    </article>
  )}
  <script is:inline define:vars={{ slug: post.id }}>
    try { const k = 'd4a-read', r = JSON.parse(localStorage.getItem(k) || '[]'); if (!r.includes(slug)) { r.push(slug); localStorage.setItem(k, JSON.stringify(r)); } } catch (e) {}
  </script>
  <script is:inline>
    // 实验 iframe 随内容自动长高（同源，可直接量），页面里不再出现第二个滚动条
    document.querySelectorAll('iframe[data-autosize]').forEach((f) => {
      const fit = () => { try { const d = f.contentDocument; if (!d || !d.documentElement) return; const h = Math.max(d.documentElement.scrollHeight, d.body ? d.body.scrollHeight : 0); if (h > 0) f.style.height = h + 'px'; } catch (e) {} };
      const hook = () => { fit(); try { const d = f.contentDocument; if (d && d.documentElement && 'ResizeObserver' in window) new ResizeObserver(fit).observe(d.documentElement); if (d && d.body) new ResizeObserver(fit).observe(d.body); } catch (e) {} [200, 800, 2000].forEach((ms) => setTimeout(fit, ms)); };
      f.addEventListener('load', hook); if (f.contentDocument && f.contentDocument.readyState === 'complete') hook();
      window.addEventListener('resize', fit);
    });
  </script>
</Base>
