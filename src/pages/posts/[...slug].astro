---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import WhatsAppJoin from '../../components/WhatsAppJoin.astro';
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: post }));
}
const post = Astro.props;
const { Content } = await render(post);
const series = post.data.series
  ? (await getCollection('blog')).filter((p) => p.data.series === post.data.series).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  : [];
const idx = series.findIndex((p) => p.id === post.id);
const prev = idx > 0 ? series[idx - 1] : null;
const next = idx >= 0 && idx < series.length - 1 ? series[idx + 1] : null;
---
<Base title={`${post.data.title} · Door4AI Lab`} description={post.data.description} full>
  <article>
    {post.data.lab ? (
      <>
        <h1 class="sr-only">{post.data.title}</h1>
        <iframe class="lab-embed" src={post.data.lab} title={post.data.title} scrolling="no" data-autosize></iframe>
      </>
    ) : (
      <header class="post-body post-head">
        <div class="eyebrow">{post.data.tags.join(' · ')}</div>
        <h1>{post.data.title.includes('：') ? (<>{post.data.title.split('：')[0]}：<br />{post.data.title.split('：').slice(1).join('：')}</>) : post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
      </header>
    )}
    <div class="post-body">
      <div class="prose"><Content /></div>
      {post.data.series && <WhatsAppJoin variant="inline" />}
      {(prev || next) && (
        <nav class="pager" aria-label="上一讲 / 下一讲">
          {prev && <a class="prev" href={`/posts/${prev.id}/`}><small>← 上一讲</small><span>{prev.data.title}</span></a>}
          {next && <a class="next" href={`/posts/${next.id}/`}><small>下一讲 →</small><span>{next.data.title}</span></a>}
        </nav>
      )}
    </div>
  </article>
  <script is:inline>
    // 学习记录（课程目录的学习面板用）：按本地日期计数，每打开一次文章 +1，重复读也算；只保留最近 400 天
    try {
      const d = new Date(), day = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      const k = 'd4a-activity', log = JSON.parse(localStorage.getItem(k) || '{}');
      Object.keys(log).forEach((x) => { if (Array.isArray(log[x])) log[x] = log[x].length; }); // 旧格式（当天读过的讲）换算成次数
      log[day] = (+log[day] || 0) + 1;
      const cut = new Date(d.getTime() - 400 * 864e5).toISOString().slice(0, 10);
      Object.keys(log).forEach((x) => { if (x < cut) delete log[x]; });
      localStorage.setItem(k, JSON.stringify(log));
      localStorage.removeItem('d4a-read'); // 不再记「已读」
    } catch (e) {}
  </script>
  <script is:inline>
    // 实验 iframe 随内容自动长高（同源，可直接量），页面里不再出现第二个滚动条
    document.querySelectorAll('iframe[data-autosize]').forEach((f) => {
      const fit = () => { try { const d = f.contentDocument; if (!d || !d.documentElement) return; const h = Math.max(d.documentElement.scrollHeight, d.body ? d.body.scrollHeight : 0); if (h > 0) f.style.height = h + 'px'; } catch (e) {} };
      const hook = () => { fit(); try { const d = f.contentDocument; if (d && d.documentElement && 'ResizeObserver' in window) new ResizeObserver(fit).observe(d.documentElement); if (d && d.body) new ResizeObserver(fit).observe(d.body); } catch (e) {} [200, 800, 2000].forEach((ms) => setTimeout(fit, ms)); };
      f.addEventListener('load', hook); if (f.contentDocument && f.contentDocument.readyState === 'complete') hook();
      window.addEventListener('resize', fit);
    });
  </script>
</Base>
