---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base title="Door4AI Lab">
  <div class="eyebrow">interactive explainers</div>
  <h1>动手理解 AI</h1>
  <p class="prose" style="color:var(--muted)">每篇文章配一个可以拖滑块、改参数的小实验。不看示意图，看真实计算。</p>
  <ul style="list-style:none;padding:0;margin:40px 0 0">
    {posts.map((p) => (
      <li style="padding:18px 0;border-top:1px solid var(--line)">
        <div class="eyebrow">{fmt(p.data.pubDate)}{p.data.lab && ' · 含实验'}</div>
        <a href={`/posts/${p.id}/`} style="font-size:22px;font-weight:700;text-decoration:none;color:var(--fg)">{p.data.title}</a>
        <p style="margin:6px 0 0;color:var(--muted)">{p.data.description}</p>
        {p.data.tags.length > 0 && <div class="tags">{p.data.tags.map((t) => <span class="tag">{t}</span>)}</div>}
      </li>
    ))}
  </ul>
</Base>
