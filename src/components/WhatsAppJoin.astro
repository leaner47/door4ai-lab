---
// WhatsApp 交流群入口。variant="menu"：头像下拉菜单里的可展开项（电脑端带二维码，登录后才显示）；variant="inline"：课程文章末尾一行。
import fs from 'node:fs';
import path from 'node:path';
import QRCode from 'qrcode';
import { whatsapp } from '../data/community';
interface Props { variant?: 'menu' | 'inline' }
const { variant = 'menu' } = Astro.props;
const url = whatsapp.url;
const icon = url ? fs.readFileSync(path.join(process.cwd(), 'public/logos/whatsapp.svg'), 'utf8').replace(/<!--.*?-->/, '').replace('<svg', '<svg aria-hidden="true" fill="currentColor"') : '';
const qr = url && variant === 'menu' ? await QRCode.toString(url, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#111214', light: '#ffffff' } }) : '';
---
{url && variant === 'menu' && (
  <>
    <button class="menu-item" type="button" role="menuitem" id="wa-toggle" aria-expanded="false" aria-controls="wa-sub" data-signed-in hidden>WhatsApp 交流群<svg class="chev" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <div class="submenu wa-sub" id="wa-sub" role="group" aria-label="WhatsApp 交流群" hidden>
      <div class="wa-qr-box" set:html={qr} />
      <p class="wa-note">手机扫码加入「{whatsapp.name}」<br />入群需管理员审核</p>
      <a class="wa-btn" href={url} target="_blank" rel="noopener"><span class="wa-ic" set:html={icon} />加入群聊</a>
    </div>
  </>
)}
{url && variant === 'inline' && (
  <aside class="wa-inline">
    <span class="wa-ic" set:html={icon} />
    <span>有问题想讨论？来 WhatsApp 群「{whatsapp.name}」里问。</span>
    <a href={url} target="_blank" rel="noopener">加入群聊 →</a>
  </aside>
)}
<style>
  .wa-ic{display:inline-flex;width:1.1em;height:1.1em}
  .wa-ic :global(svg){width:100%;height:100%}
  .wa-sub{display:flex;flex-direction:column;align-items:center;gap:8px;padding:6px 24px 12px}
  .wa-sub[hidden]{display:none}
  .wa-qr-box{width:132px;height:132px;padding:8px;background:#fff;border-radius:8px;box-sizing:content-box;border:1px solid var(--line)}
  .wa-qr-box :global(svg){display:block;width:100%;height:100%}
  .wa-note{margin:0;font-size:12.5px;line-height:1.5;color:var(--muted);text-align:center}
  .wa-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:8px 14px;border-radius:999px;background:#25d366;color:#06291a;font-weight:700;font-size:15px;text-decoration:none;transition:filter .15s}
  .wa-btn:hover{filter:brightness(1.06)}
  .wa-btn:focus-visible{outline:2px solid #25d366;outline-offset:3px}
  @media (max-width:640px){.wa-qr-box,.wa-note{display:none}}
  .wa-inline{display:flex;align-items:center;flex-wrap:wrap;gap:6px 10px;margin:48px 0 0;padding:14px 16px;border:1px solid var(--line);border-radius:8px;background:var(--paper);font-size:15.5px;color:var(--muted);max-width:68ch}
  .wa-inline .wa-ic{color:#25d366}
  .wa-inline a{margin-left:auto;font-weight:700;text-decoration:none;color:#1a9e4b}
  @media (prefers-color-scheme:dark){:global(:root:not([data-theme="light"])) .wa-inline a{color:#25d366}}
  :global(:root[data-theme="dark"]) .wa-inline a{color:#25d366}
</style>
