---
// Holographic card (ported from React Bits HoloCard). The art is an SVG generated from the props.
// With `href` the whole card is a link (used as a download button).
interface Props {
  title: string;        // big text in the middle (e.g. platform)
  kicker?: string;      // small text at the top (e.g. app name)
  foot?: string;        // small text at the bottom (e.g. 点击下载)
  preset?: 'bursts' | 'stars' | 'shards' | 'cosmos' | 'rainbow' | 'swirl' | 'glitter' | 'gold';
  foil?: string;
  width?: number;
  accent?: string;
  href?: string;
  external?: boolean;
  dl?: string;          // mirror id, exposed as data-dl for the manifest script
}
const { title, kicker = '', foot = '点击下载', preset = 'glitter', foil = '#e2e6ec', width = 150, accent = '#6f9cf0', href, external = false, dl } = Astro.props;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
// split the title on " · " so two-part labels stack
const parts = title.split(' · ');
const tsize = Math.max(...parts.map((p) => p.length)) > 9 ? 64 : 84;
const lines = parts.map((p, i) => `<text x="315" y="${parts.length === 1 ? 470 : 420 + i * 100}" text-anchor="middle" font-family="Times New Roman, Times, PingFang SC, Heiti SC, sans-serif" font-size="${i === 0 ? tsize : tsize * 0.8}" font-weight="700" fill="#f4f1ea">${esc(p)}</text>`).join('');
const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="630" height="880" viewBox="0 0 630 880">
<defs>
  <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0c0f14"/><stop offset="1" stop-color="#1b2230"/></linearGradient>
  <radialGradient id="glow" cx="0.5" cy="0.35" r="0.7"><stop offset="0" stop-color="${accent}" stop-opacity="0.5"/><stop offset="1" stop-color="${accent}" stop-opacity="0"/></radialGradient>
</defs>
<rect width="630" height="880" fill="url(#bg)"/>
<rect width="630" height="880" fill="url(#glow)"/>
<rect x="28" y="28" width="574" height="824" rx="22" fill="none" stroke="${accent}" stroke-opacity="0.5" stroke-width="3"/>
<text x="315" y="150" text-anchor="middle" font-family="Times New Roman, Times, serif" font-size="56" letter-spacing="2" fill="${accent}">${esc(kicker)}</text>
${lines}
<text x="315" y="790" text-anchor="middle" font-family="Times New Roman, Times, PingFang SC, Heiti SC, sans-serif" font-size="38" fill="#aab2bf">${esc(foot)}</text>
</svg>`;
const image = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
const Tag = href ? 'a' : 'div';
---
<Tag class="holo-card" aria-label={`${kicker} ${title}`} data-image={image} data-preset={preset} data-foil={foil} data-intensity="0.55" data-edge="0.8" data-tilt="16" data-hover="1.06" data-dl={dl} href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} style={`--hc-w:${width}px`}>
  <span class="holo-card__shadow" aria-hidden="true"></span>
  <div class="holo-card__rotor">
    <div class="holo-card__face holo-card__face--front">
      <img src={image} alt="" draggable="false" />
      <canvas></canvas>
    </div>
  </div>
</Tag>

<style is:global>
  @import '../scripts/holo-card.css';
  a.holo-card{cursor:pointer;text-decoration:none;color:inherit}
  a.holo-card:focus-visible{outline:2px solid var(--accent);outline-offset:6px}
  .holo-card.off{opacity:.45;pointer-events:none}
</style>
<script>
  import { initHoloCards } from '../scripts/holo-card.js';
  initHoloCards();
</script>
