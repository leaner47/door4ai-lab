---
// Holographic card (ported from React Bits HoloCard). The art is an SVG generated from the props:
// a brand logo in the middle, the app name on top, the platform under the logo, a footer line.
// With `href` the whole card is a link (used as a download button).
import fs from 'node:fs';
import path from 'node:path';
interface Props {
  title: string;        // platform label, e.g. "macOS · Apple 芯片"
  kicker?: string;      // app name
  foot?: string;        // bottom line, e.g. 点击下载
  logo?: string;        // app logo (small, top), file under public/logos/
  platformLogo?: string;// platform glyph (large, middle), file under public/logos/
  logoScale?: number;   // platform logo size, 0..1 of card width (default 0.5)
  preset?: 'bursts' | 'stars' | 'shards' | 'cosmos' | 'rainbow' | 'swirl' | 'glitter' | 'gold';
  foil?: string;        // foil tint — pass the brand color
  width?: number;
  accent?: string;      // glow/border color — brand color
  href?: string;
  external?: boolean;
  dl?: string;
}
const { title, kicker = '', foot = '点击下载', logo, platformLogo, logoScale = 0.5, preset = 'glitter', foil = '#e2e6ec', width = 150, accent = '#6f9cf0', href, external = false, dl } = Astro.props;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

// embed logos as data URIs so the whole card art is one self-contained image (WebGL texture)
const dataUri = (name: string | undefined, color = '#ffffff') => {
  if (!name) return '';
  const buf = fs.readFileSync(path.join(process.cwd(), 'public', 'logos', name));
  if (name.endsWith('.svg')) {
    let txt = buf.toString('utf8').replace(/currentColor/g, color);
    // glyph-only SVGs (Font Awesome) carry no fill: paint them in the given color
    if (!/fill=/.test(txt.replace(/fill="none"/g, ''))) txt = txt.replace('<svg', `<svg fill="${color}"`);
    return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(txt);
  }
  return `data:image/${name.endsWith('.png') ? 'png' : 'jpeg'};base64,` + buf.toString('base64');
};
const logoHref = dataUri(logo);
const platHref = dataUri(platformLogo, '#f4f1ea');
const L = Math.round(630 * logoScale);
const S = 96; // small app logo
const parts = title.split(' · ');
const t1 = parts[0], t2 = parts.slice(1).join(' · ');
const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="630" height="880" viewBox="0 0 630 880">
<defs>
  <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0b0d11"/><stop offset="1" stop-color="#161b24"/></linearGradient>
  <radialGradient id="glow" cx="0.5" cy="0.42" r="0.6"><stop offset="0" stop-color="${accent}" stop-opacity="0.42"/><stop offset="1" stop-color="${accent}" stop-opacity="0"/></radialGradient>
</defs>
<rect width="630" height="880" fill="url(#bg)"/>
<rect width="630" height="880" fill="url(#glow)"/>
<rect x="28" y="28" width="574" height="824" rx="22" fill="none" stroke="${accent}" stroke-opacity="0.55" stroke-width="3"/>
${logoHref ? `<image href="${logoHref}" x="${315 - S / 2}" y="70" width="${S}" height="${S}" preserveAspectRatio="xMidYMid meet"/>` : ''}
<text x="315" y="${logoHref ? 215 : 130}" text-anchor="middle" font-family="Times New Roman, Times, serif" font-size="40" letter-spacing="2" fill="${accent}">${esc(kicker)}</text>
${platHref ? `<image href="${platHref}" x="${315 - L / 2}" y="${430 - L / 2}" width="${L}" height="${L}" preserveAspectRatio="xMidYMid meet"/>` : (logoHref ? `<image href="${logoHref}" x="${315 - L / 2}" y="${430 - L / 2}" width="${L}" height="${L}" preserveAspectRatio="xMidYMid meet"/>` : '')}
<text x="315" y="${430 + L / 2 + 80}" text-anchor="middle" font-family="Times New Roman, Times, PingFang SC, Heiti SC, sans-serif" font-size="58" font-weight="700" fill="#f4f1ea">${esc(t1)}</text>
${t2 ? `<text x="315" y="${430 + L / 2 + 132}" text-anchor="middle" font-family="Times New Roman, Times, PingFang SC, Heiti SC, sans-serif" font-size="38" fill="#d5d9e0">${esc(t2)}</text>` : ''}
<text x="315" y="800" text-anchor="middle" font-family="Times New Roman, Times, PingFang SC, Heiti SC, sans-serif" font-size="32" fill="#9aa1ab">${esc(foot)}</text>
</svg>`;
const image = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
const Tag = href ? 'a' : 'div';
---
<Tag class="holo-card" aria-label={`${kicker} ${title}`} data-image={image} data-preset={preset} data-foil={foil} data-intensity="0.6" data-edge="0.8" data-tint="0.65" data-tilt="16" data-hover="1.06" data-dl={dl} href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} style={`--hc-w:${width}px`}>
  <span class="holo-card__shadow" aria-hidden="true"></span>
  <div class="holo-card__rotor">
    <div class="holo-card__face holo-card__face--front">
      <img src={image} alt="" draggable="false" />
      <canvas></canvas>
    </div>
  </div>
</Tag>

<style is:global>
  @import '../scripts/holo-card.css';
  a.holo-card{cursor:pointer;text-decoration:none;color:inherit}
  a.holo-card:focus-visible{outline:2px solid var(--accent);outline-offset:6px}
  .holo-card.off{opacity:.45;pointer-events:none}
</style>
<script>
  import { initHoloCards } from '../scripts/holo-card.js';
  initHoloCards();
</script>
