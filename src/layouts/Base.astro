---
interface Props { title: string; description?: string; full?: boolean }
const { title, description = 'Door4AI Lab — 动手理解 AI 的可交互教学博客', full = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="Door4AI Lab" href="/rss.xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <style is:global>
    :root{
      --bg:#f7f3ea; --paper:#fffdf8; --fg:#1d2126; --muted:#5f6670; --line:#d9d6cd;
      --accent:#1f5fd1; --accent-soft:#dfe8fb;
      --sans:"Times New Roman",Times,"PingFang SC","Heiti SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans SC",sans-serif;
      --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
    }
    @media (prefers-color-scheme: dark){ :root{
      --bg:#000; --paper:#111214; --fg:#e8e6df; --muted:#9aa1ab; --line:#2a2d31;
      --accent:#6f9cf0; --accent-soft:#23334f; color-scheme:dark } }
    *{box-sizing:border-box}
    html,body{margin:0}
    body{background:var(--bg);color:var(--fg);font-family:var(--sans);font-size:17px;line-height:1.8}
    a{color:var(--accent)}
    html,body{height:100%}
    body{display:flex;flex-direction:column;min-height:100dvh}
    .wrap{flex:1;display:flex;flex-direction:column;width:100%}
    header.site{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;padding:22px clamp(16px,3vw,40px);border-bottom:1px solid var(--line)}
    header.site .brand{font-weight:700;font-size:20px;text-decoration:none;color:var(--fg)}
    header.site .brand span{color:var(--accent)}
    header.site nav a{color:var(--muted);text-decoration:none;margin-left:18px;font-size:15px}
    header.site nav #auth span{margin-left:18px}
    header.site nav a:hover{color:var(--fg)}
    main{flex:1;display:flex;flex-direction:column;width:100%;max-width:900px;margin:0 auto;padding:40px clamp(16px,3vw,40px) 80px;box-sizing:border-box}
    main.full{max-width:none;padding:0}
    footer.site{border-top:1px solid var(--line);padding:20px clamp(16px,3vw,40px) 28px;color:var(--muted);font-size:14px}
    .eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
    h1{font-size:clamp(28px,5vw,40px);line-height:1.2;margin:8px 0 12px;text-wrap:balance}
    .prose{max-width:68ch}
    .prose h2{font-size:22px;margin:40px 0 8px}
    .prose h3{font-size:18px;margin:28px 0 6px}
    .prose p,.prose li{max-width:68ch}
    .prose code{font-family:var(--mono);font-size:.88em;background:var(--accent-soft);padding:1px 5px;border-radius:3px}
    .prose pre{background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:14px 16px;overflow-x:auto;font-size:14px;line-height:1.6}
    .prose pre code{background:none;padding:0}
    .prose blockquote{border-left:3px solid var(--accent);margin:16px 0;padding:4px 0 4px 16px;color:var(--muted)}
    .prose img{max-width:100%}
    .prose table{border-collapse:collapse;width:100%;font-size:15px}
    .prose th,.prose td{text-align:left;padding:7px 8px;border-bottom:1px solid var(--line)}
    .lab-frame{margin:28px 0;border:1px solid var(--line);border-radius:6px;overflow:hidden;background:var(--paper)}
    .lab-frame iframe{display:block;width:100%;height:min(85vh,900px);border:0}
    .lab-frame .bar{display:flex;justify-content:space-between;align-items:center;padding:8px 14px;border-bottom:1px solid var(--line);font-size:13px;color:var(--muted)}
    .motto-only{flex:1;display:flex;align-items:center;justify-content:center;text-align:center;padding:40px 16px}
    .motto{margin:0;font-family:"Times New Roman",Times,serif;font-size:clamp(32px,6.5vw,96px);font-weight:400;letter-spacing:.02em;line-height:1.25;text-wrap:balance}
    .motto em{font-style:italic;color:var(--accent)}
    .postlist{list-style:none;padding:0;margin:28px 0 0}
    .postlist li{padding:18px 0;border-top:1px solid var(--line)}
    .postlist a.t{font-size:22px;font-weight:700;text-decoration:none;color:var(--fg)}
    .postlist p{margin:6px 0 0;color:var(--muted)}
    .resgroup{margin-top:44px;padding-top:28px;border-top:1px solid var(--line)}
    .resgroup .rt{font-size:24px;margin:0 0 4px}
    .resgroup .d{margin:0;color:var(--muted);font-size:15px;max-width:68ch}
    .cards{display:flex;flex-wrap:wrap;gap:26px 22px;margin-top:22px}
    .cardwrap{margin:0;display:flex;flex-direction:column;align-items:center;gap:8px;width:150px}
    .cardwrap figcaption{font-family:var(--mono);font-size:12px;color:var(--muted);text-align:center;line-height:1.4;font-variant-numeric:tabular-nums}
    .plat{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin-top:8px}
    .plat a{display:block;text-decoration:none;background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:10px 12px;font-weight:700;min-width:0}
    .plat a:hover{border-color:var(--accent)}
    .plat a.off{opacity:.55;pointer-events:none}
    .plat a small{display:block;font-weight:400;color:var(--muted);font-size:12.5px;line-height:1.5;margin-top:3px;word-break:break-all}
    .tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
    .tag{font-family:var(--mono);font-size:12px;color:var(--muted);border:1px solid var(--line);border-radius:3px;padding:1px 7px}
  </style>
</head>
<body>
  <div class="wrap">
    <header class="site">
      <a class="brand" href="/">Door4AI <span>Lab</span></a>
      <nav><a href="/ai/">AI从入门到精通</a><a href="/resources/">Resource</a><span id="auth"><a href="/ai/">登录</a></span></nav>
    </header>
    <main class:list={[{ full }]}><slot /></main>
    <script>
      // Cloudflare Access: show email + logout when a session exists, otherwise a login link.
      (async () => {
        const el = document.getElementById('auth'); if (!el) return;
        try {
          const r = await fetch('/cdn-cgi/access/get-identity', { credentials: 'include' });
          if (!r.ok) return;
          const id = await r.json();
          if (id && id.email) el.innerHTML = `<span style="color:var(--muted);font-size:13px">${id.email}</span><a href="/cdn-cgi/access/logout">退出</a>`;
        } catch (e) {}
      })();
    </script>
    <footer class="site">© {new Date().getFullYear()} Door4AI Lab · 动手理解 AI · <a href="https://door4ai.com">door4ai.com</a></footer>
  </div>
</body>
</html>
