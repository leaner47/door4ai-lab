---
interface Props { title: string; description?: string; full?: boolean }
const { title, description = 'Door4AI Lab — 动手理解 AI 的可交互教学博客', full = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="Door4AI Lab" href="/rss.xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <script is:inline>try{var t=localStorage.getItem("d4a-theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t}catch(e){}</script>
  <style is:global>
    :root{
      --bg:#f7f3ea; --paper:#fffdf8; --fg:#1d2126; --muted:#5f6670; --line:#d9d6cd;
      --accent:#1f5fd1; --accent-soft:#dfe8fb;
      --sans:"Times New Roman",Times,"PingFang SC","Heiti SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans SC",sans-serif;
      --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
    }
    @media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){
      --bg:#000; --paper:#111214; --fg:#e8e6df; --muted:#9aa1ab; --line:#2a2d31;
      --accent:#6f9cf0; --accent-soft:#23334f; color-scheme:dark } }
    :root[data-theme="dark"]{
      --bg:#000; --paper:#111214; --fg:#e8e6df; --muted:#9aa1ab; --line:#2a2d31;
      --accent:#6f9cf0; --accent-soft:#23334f; color-scheme:dark }
    :root[data-theme="light"]{color-scheme:light}
    :root{--menu-bg:#fff;--menu-shadow:0 10px 30px rgba(20,22,26,.12),0 2px 6px rgba(20,22,26,.06);--chip:#ece8de}
    @media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){--menu-bg:#17181b;--menu-shadow:0 12px 32px rgba(0,0,0,.6);--chip:#1c1e21} }
    :root[data-theme="dark"]{--menu-bg:#17181b;--menu-shadow:0 12px 32px rgba(0,0,0,.6);--chip:#1c1e21}
    *{box-sizing:border-box}
    [hidden]{display:none !important}
    html,body{margin:0}
    body{background:var(--bg);color:var(--fg);font-family:var(--sans);font-size:17px;line-height:1.8}
    a{color:var(--accent)}
    html,body{height:100%}
    body{display:flex;flex-direction:column;min-height:100dvh}
    .wrap{flex:1;display:flex;flex-direction:column;width:100%}
    header.site{display:flex;align-items:center;gap:16px 28px;flex-wrap:wrap;padding:16px clamp(16px,3vw,40px);border-bottom:1px solid var(--line)}
    header.site nav{margin-left:auto}
    .acts{display:flex;align-items:center;gap:14px}
    .support{display:inline-flex;align-items:center;gap:7px;color:var(--fg);text-decoration:none;font-size:16px;padding:6px 4px}
    .support svg{width:17px;height:17px}
    .support:hover{color:var(--accent)}
    .acct{position:relative}
    .acct-btn{display:grid;place-items:center;width:40px;height:40px;border:0;border-radius:10px;background:var(--chip);color:var(--fg);cursor:pointer;padding:0;transition:filter .15s}
    .acct-btn:hover{filter:brightness(.96)}
    .acct-btn svg{width:18px;height:18px}
    .acct-btn:focus-visible,.menu-item:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
    .acct-menu{position:absolute;right:0;top:calc(100% + 10px);z-index:50;min-width:236px;padding:6px 0;background:var(--menu-bg);border:1px solid var(--line);border-radius:12px;box-shadow:var(--menu-shadow);font-size:17px;line-height:1.4}
    .acct-menu .who{padding:12px 24px 10px;border-bottom:1px solid var(--line);margin-bottom:6px}
    .acct-menu .who b{display:block;font-size:13px;font-weight:400;color:var(--muted);word-break:break-all}
    .menu-item{display:flex;align-items:center;justify-content:space-between;gap:16px;width:100%;padding:11px 24px;border:0;background:none;color:var(--fg);font:inherit;text-align:left;text-decoration:none;cursor:pointer}
    .menu-item:hover{background:var(--chip)}
    .menu-item .chev{width:16px;height:16px;color:var(--muted);transition:transform .2s}
    .menu-item[aria-expanded="true"] .chev{transform:rotate(90deg)}
    .menu-item .check{width:16px;height:16px;color:var(--accent);visibility:hidden}
    .menu-item[aria-checked="true"] .check{visibility:visible}
    .submenu{padding:2px 0 6px}
    .submenu .menu-item{padding-left:40px;font-size:15.5px;color:var(--muted)}
    .submenu .menu-item[aria-checked="true"]{color:var(--fg)}
    .acct-menu hr{border:0;border-top:1px solid var(--line);margin:6px 10px}
    @media (max-width:560px){header.site nav{order:3;width:100%;margin-left:0}.acts{margin-left:auto}.support span{display:none}}
    header.site .brand{font-weight:700;font-size:20px;text-decoration:none;color:var(--fg)}
    header.site .brand span{color:var(--accent)}
    header.site nav{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 18px}
    header.site nav a{color:var(--muted);text-decoration:none;font-size:15px}
    @media (max-width:560px){header.site{padding-top:12px;padding-bottom:10px;row-gap:4px}}
    header.site nav a:hover{color:var(--fg)}
    main{flex:1;display:flex;flex-direction:column;width:100%;max-width:900px;margin:0 auto;padding:40px clamp(16px,3vw,40px) 80px;box-sizing:border-box}
    main.full{max-width:none;padding:0}
    footer.site{border-top:1px solid var(--line);padding:20px clamp(16px,3vw,40px) 28px;color:var(--muted);font-size:14px}
    .eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
    h1{font-size:clamp(28px,5vw,40px);line-height:1.2;margin:8px 0 12px;text-wrap:balance}
    .prose{max-width:68ch}
    .prose h2{font-size:22px;margin:40px 0 8px}
    .prose h3{font-size:18px;margin:28px 0 6px}
    .prose p,.prose li{max-width:68ch}
    .prose code{font-family:var(--mono);font-size:.88em;background:var(--accent-soft);padding:1px 5px;border-radius:3px}
    .prose pre{background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:14px 16px;overflow-x:auto;font-size:14px;line-height:1.6}
    .prose pre code{background:none;padding:0}
    .prose blockquote{border-left:3px solid var(--accent);margin:16px 0;padding:4px 0 4px 16px;color:var(--muted)}
    .prose img{max-width:100%}
    .prose table{border-collapse:collapse;width:100%;font-size:15px}
    .prose th,.prose td{text-align:left;padding:7px 8px;border-bottom:1px solid var(--line)}
    .lab-frame{margin:28px 0;border:1px solid var(--line);border-radius:6px;overflow:hidden;background:var(--paper)}
    .lab-frame iframe{display:block;width:100%;height:600px;border:0;overflow:hidden}
    .lab-frame .bar{display:flex;justify-content:space-between;align-items:center;padding:8px 14px;border-bottom:1px solid var(--line);font-size:13px;color:var(--muted)}
    .motto-only{flex:1;display:flex;align-items:center;justify-content:center;text-align:center;padding:40px 16px}
    .motto{margin:0;font-family:"Times New Roman",Times,serif;font-size:clamp(32px,6.5vw,96px);font-weight:400;letter-spacing:.02em;line-height:1.25;text-wrap:balance}
    .motto em{font-style:italic;color:var(--accent)}
    .postlist{list-style:none;padding:0;margin:28px 0 0}
    .postlist li{display:grid;grid-template-columns:72px 1fr;gap:0 8px;padding:22px 0;border-top:1px solid var(--line)}
    .postlist li:last-child{border-bottom:1px solid var(--line)}
    .postlist .num{font-size:48px;line-height:1;color:var(--line);font-variant-numeric:lining-nums;padding-top:4px;transition:color .2s}
    .postlist li:hover .num,.postlist li.next .num{color:var(--accent)}
    .postlist li.read .num{color:var(--muted)}
    .postlist .meta{display:flex;align-items:center;flex-wrap:wrap;gap:8px}
    .postlist .badge{font-size:12px;line-height:1;padding:4px 8px;border-radius:999px;background:var(--accent);color:var(--bg);letter-spacing:.04em}
    .postlist .badge.done{background:transparent;color:var(--muted);border:1px solid var(--line)}
    .postlist a.t{display:inline-block;margin-top:2px;font-size:22px;font-weight:700;line-height:1.4;text-decoration:none;color:var(--fg)}
    .postlist a.t:hover{color:var(--accent)}
    .postlist p{margin:6px 0 0;color:var(--muted)}
    .progress{display:flex;align-items:center;gap:12px;margin-top:20px;font-size:14px;color:var(--muted)}
    .progress[hidden]{display:none}
    .progress .track{flex:0 1 220px;height:4px;border-radius:2px;background:var(--line);overflow:hidden}
    .progress .fill{display:block;height:100%;width:0;background:var(--accent);transition:width .4s}
    @media (max-width:520px){.postlist li{grid-template-columns:44px 1fr}.postlist .num{font-size:34px}.postlist a.t{font-size:20px}}
    .reshead{max-width:900px;margin:0 auto;padding:0 clamp(16px,3vw,40px);box-sizing:border-box}
    main.full .reshead:first-child{padding-top:40px}
    .resgroup{margin-top:0;padding-top:28px;border-top:1px solid var(--line)}
    .resgroup:first-child{border-top:0;padding-top:16px}
    .resgroup .rt{font-size:24px;margin:0;text-align:center}
    .cardwrap{margin:0;display:flex;flex-direction:column;align-items:center;gap:10px}
    .cardwrap figcaption{font-family:var(--mono);font-size:12px;color:var(--muted);text-align:center;line-height:1.4;font-variant-numeric:tabular-nums;white-space:nowrap}
    /* flat card row: horizontal scroll with snap, centered when it fits */
    .cardrow{display:flex;gap:26px;padding:22px clamp(16px,3vw,40px) 18px;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x proximity;scroll-behavior:smooth;scroll-padding-inline:clamp(16px,3vw,40px);-webkit-overflow-scrolling:touch;scrollbar-width:thin;scrollbar-color:var(--line) transparent}
    .cardrow::-webkit-scrollbar{height:6px}
    .cardrow::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px}
    .cardrow > .cardwrap{flex:0 0 auto;scroll-snap-align:center}
    .cardrow > .cardwrap:first-child{margin-left:auto}
    .cardrow > .cardwrap:last-child{margin-right:auto}
    .plat{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin-top:8px}
    .plat a{display:block;text-decoration:none;background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:10px 12px;font-weight:700;min-width:0}
    .plat a:hover{border-color:var(--accent)}
    .plat a.off{opacity:.55;pointer-events:none}
    .plat a small{display:block;font-weight:400;color:var(--muted);font-size:12.5px;line-height:1.5;margin-top:3px;word-break:break-all}
    .tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
    .tag{font-family:var(--mono);font-size:12px;color:var(--muted);border:1px solid var(--line);border-radius:3px;padding:1px 7px}
  </style>
</head>
<body>
  <div class="wrap">
    <header class="site">
      <a class="brand" href="/">Door4AI <span>Lab</span></a>
      <nav><a href="/ai/">AI从入门到精通</a><a href="/resources/">Resource</a></nav>
      <div class="acts">
        <a class="support" href="/ai/#community"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="currentColor"/><path d="M7.6 7.6a2.5 2.5 0 1 1 3.6 2.2c-.7.4-1.2.9-1.2 1.7v.4" fill="none" stroke="var(--bg)" stroke-width="1.8" stroke-linecap="round"/><circle cx="10" cy="14.6" r="1.1" fill="var(--bg)"/></svg><span>支持</span></a>
        <div class="acct">
          <button class="acct-btn" id="acct-btn" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="acct-menu" aria-label="账号"><svg viewBox="0 0 448 512" aria-hidden="true" fill="currentColor"><path d="M224 256a128 128 0 1 0 0-256 128 128 0 1 0 0 256zm-45.7 48C79.8 304 0 383.8 0 482.3 0 498.7 13.3 512 29.7 512h388.6c16.4 0 29.7-13.3 29.7-29.7C448 383.8 368.2 304 269.7 304h-91.4z"/></svg></button>
          <div class="acct-menu" id="acct-menu" role="menu" hidden>
            <div class="who" id="acct-who" hidden><b id="acct-email"></b></div>
            <a class="menu-item" role="menuitem" id="acct-login" href="/ai/">登录</a>
            <a class="menu-item" role="menuitem" id="acct-profile" href="/account/" hidden>个人资料</a>
            <button class="menu-item" type="button" role="menuitem" id="theme-toggle" aria-expanded="false" aria-controls="theme-sub">外观<svg class="chev" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            <div class="submenu" id="theme-sub" role="group" aria-label="外观" hidden>
              <button class="menu-item" type="button" role="menuitemradio" data-theme-opt="system">跟随系统<svg class="check" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              <button class="menu-item" type="button" role="menuitemradio" data-theme-opt="light">浅色<svg class="check" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              <button class="menu-item" type="button" role="menuitemradio" data-theme-opt="dark">深色<svg class="check" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            </div>
            <div id="acct-out" hidden><hr /><a class="menu-item" role="menuitem" id="acct-logout" href="/cdn-cgi/access/logout">退出登录</a></div>
          </div>
        </div>
      </div>
    </header>
    <main class:list={[{ full }]}><slot /></main>
    <script>
      // 右上角账号菜单。登录状态：自建账号启用时（/api/me 返回 enabled:true）用它，否则沿用 Cloudflare Access。
      (() => {
        const $ = (id) => document.getElementById(id);
        const btn = $('acct-btn'), menu = $('acct-menu');
        if (!btn || !menu) return;
        const open = (v) => { menu.hidden = !v; btn.setAttribute('aria-expanded', String(v)); };
        btn.addEventListener('click', (e) => { e.stopPropagation(); open(menu.hidden); });
        document.addEventListener('click', (e) => { if (!menu.hidden && !menu.contains(e.target)) open(false); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { open(false); btn.focus(); } });

        // 外观：跟随系统 / 浅色 / 深色，存在本机 localStorage；同步给页面里嵌入的实验 iframe（同源）
        const sub = $('theme-sub'), tog = $('theme-toggle');
        tog.addEventListener('click', () => { sub.hidden = !sub.hidden; tog.setAttribute('aria-expanded', String(!sub.hidden)); });
        const get = () => { try { return localStorage.getItem('d4a-theme') || 'system'; } catch (e) { return 'system'; } };
        const apply = (t) => {
          const set = (root) => { if (t === 'system') delete root.dataset.theme; else root.dataset.theme = t; };
          set(document.documentElement);
          document.querySelectorAll('iframe').forEach((f) => { try { f.contentDocument && set(f.contentDocument.documentElement); } catch (e) {} });
          document.querySelectorAll('[data-theme-opt]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.themeOpt === t)));
        };
        document.querySelectorAll('[data-theme-opt]').forEach((b) => b.addEventListener('click', () => {
          const t = b.dataset.themeOpt; try { t === 'system' ? localStorage.removeItem('d4a-theme') : localStorage.setItem('d4a-theme', t); } catch (e) {}
          apply(t);
        }));
        apply(get());

        const signedIn = (email, profile, logout) => {
          $('acct-email').textContent = email; $('acct-who').hidden = false;
          $('acct-login').hidden = true; $('acct-out').hidden = false;
          if (profile) $('acct-profile').hidden = false;
          if (logout) $('acct-logout').addEventListener('click', logout);
        };
        (async () => {
          try {
            const me = await fetch('/api/me', { credentials: 'same-origin' }).then((r) => r.ok ? r.json() : null).catch(() => null);
            if (me && me.enabled) {
              if (me.user) signedIn(me.user.email, true, async (e) => {
                e.preventDefault();
                await fetch('/api/auth/logout', { method: 'POST', credentials: 'same-origin' }).catch(() => {});
                location.href = '/';
              });
              else $('acct-login').href = `/login/?next=${encodeURIComponent(location.pathname + location.search)}`;
              return;
            }
            const r = await fetch('/cdn-cgi/access/get-identity', { credentials: 'include' });
            if (!r.ok) return;
            const id = await r.json();
            if (id && id.email) signedIn(id.email, false, null);
          } catch (e) {}
        })();
      })();
    </script>
    <footer class="site">© {new Date().getFullYear()} Door4AI Lab · 动手理解 AI · <a href="https://door4ai.com">door4ai.com</a></footer>
  </div>
</body>
</html>
